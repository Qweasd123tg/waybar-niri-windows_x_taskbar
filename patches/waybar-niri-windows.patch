diff --git a/module/icon.go b/module/icon.go
new file mode 100644
index 0000000..951b0d7
--- /dev/null
+++ b/module/icon.go
@@ -0,0 +1,234 @@
+package module
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"wnw/log"
+
+	"github.com/gotk3/gotk3/gtk"
+)
+
+type iconKind uint8
+
+const (
+	iconMissing iconKind = iota
+	iconTheme
+	iconFile
+)
+
+type icon struct {
+	kind  iconKind
+	value string
+}
+
+var fallbackIconCandidates = []string{
+	"application-x-executable",
+	"application-x-executable-symbolic",
+	"application-default-icon",
+	"binary",
+}
+
+type iconResult struct {
+	source icon
+	found  bool
+}
+
+type iconCache struct {
+	mu      sync.RWMutex
+	entries map[string]iconResult
+}
+
+func newIconCache() *iconCache {
+	return &iconCache{
+		entries: map[string]iconResult{},
+	}
+}
+
+func (c *iconCache) Lookup(appID string) icon {
+	appID = strings.TrimSpace(appID)
+	if appID == "" {
+		return icon{}
+	}
+
+	c.mu.RLock()
+	if cached, ok := c.entries[appID]; ok {
+		c.mu.RUnlock()
+		if cached.found {
+			return cached.source
+		}
+		return icon{}
+	}
+	c.mu.RUnlock()
+
+	source, found := resolveIcon(appID)
+
+	c.mu.Lock()
+	c.entries[appID] = iconResult{
+		source: source,
+		found:  found,
+	}
+	c.mu.Unlock()
+
+	if !found {
+		return icon{}
+	}
+
+	return source
+}
+
+func resolveIcon(appID string) (icon, bool) {
+	if iconName, ok := resolveThemeIcon(appID); ok {
+		return icon{kind: iconTheme, value: iconName}, true
+	}
+
+	resolved, ok := lookupDesktopAppIcon(appID)
+	if !ok {
+		return fallbackIcon()
+	}
+
+	if strings.HasPrefix(resolved, "/") {
+		return fallbackIcon()
+	}
+
+	if iconName, ok := resolveThemeIcon(resolved); ok {
+		return icon{kind: iconTheme, value: iconName}, true
+	}
+
+	if strings.TrimSpace(resolved) != "" {
+		return icon{kind: iconTheme, value: resolved}, true
+	}
+
+	return fallbackIcon()
+}
+
+func resolveThemeIcon(appID string) (string, bool) {
+	return resolveThemeIconCandidates(iconCandidates(appID))
+}
+
+func resolveThemeIconCandidates(candidates []string) (string, bool) {
+	theme, err := gtk.IconThemeGetDefault()
+	if err != nil {
+		log.Warnf("error getting default icon theme: %s", err)
+		return "", false
+	}
+
+	for _, candidate := range candidates {
+		if theme.HasIcon(candidate) {
+			return candidate, true
+		}
+	}
+
+	return "", false
+}
+
+func fallbackIcon() (icon, bool) {
+	if iconName, ok := resolveThemeIconCandidates(fallbackIconCandidates); ok {
+		return icon{kind: iconTheme, value: iconName}, true
+	}
+
+	return icon{}, false
+}
+
+func iconCandidates(appID string) []string {
+	candidates := make([]string, 0, 6)
+	seen := map[string]struct{}{}
+
+	add := func(candidate string) {
+		candidate = strings.TrimSpace(candidate)
+		if candidate == "" {
+			return
+		}
+		if _, ok := seen[candidate]; ok {
+			return
+		}
+		seen[candidate] = struct{}{}
+		candidates = append(candidates, candidate)
+	}
+
+	add(appID)
+	add(strings.TrimSuffix(appID, ".desktop"))
+	add(strings.ToLower(appID))
+	add(strings.ToLower(strings.TrimSuffix(appID, ".desktop")))
+
+	if head, tail, ok := strings.Cut(appID, "."); ok {
+		add(tail)
+		add(strings.ToLower(tail))
+		add(head)
+	}
+
+	if idx := strings.LastIndex(appID, "."); idx >= 0 && idx < len(appID)-1 {
+		last := appID[idx+1:]
+		add(last)
+		add(strings.ToLower(last))
+	}
+
+	return candidates
+}
+
+func (s icon) Image(windowBox *gtk.Widget, size int) (*gtk.Image, error) {
+	if size < 1 {
+		return nil, fmt.Errorf("invalid icon size %d", size)
+	}
+
+	var (
+		image *gtk.Image
+		err   error
+	)
+
+	switch s.kind {
+	case iconTheme:
+		image, err = gtk.ImageNew()
+		if err == nil {
+			image.SetFromIconName(s.value, gtk.ICON_SIZE_MENU)
+			image.SetPixelSize(size)
+		}
+	case iconFile:
+		return nil, fmt.Errorf("file-based icons are disabled for stability")
+	default:
+		return nil, fmt.Errorf("unsupported icon kind %d", s.kind)
+	}
+
+	if err != nil {
+		return nil, err
+	}
+
+	image.SetSizeRequest(size, size)
+	image.SetHAlign(gtk.ALIGN_CENTER)
+	image.SetVAlign(gtk.ALIGN_CENTER)
+	image.SetHExpand(false)
+	image.SetVExpand(false)
+
+	if style, err := image.GetStyleContext(); err == nil {
+		style.AddClass("app-icon")
+	}
+
+	return image, nil
+}
+
+func iconImage(icon icon, windowBox *gtk.Widget, size int) *gtk.Image {
+	if icon.kind == iconMissing {
+		fallback, ok := fallbackIcon()
+		if !ok {
+			return nil
+		}
+		icon = fallback
+	}
+
+	image, err := icon.Image(windowBox, size)
+	if err != nil {
+		fallback, ok := fallbackIcon()
+		if !ok || (icon.kind == fallback.kind && icon.value == fallback.value) {
+			log.Warnf("error creating icon image: %s", err)
+			return nil
+		}
+
+		image, err = fallback.Image(windowBox, size)
+		if err != nil {
+			log.Warnf("error creating icon image: %s", err)
+			return nil
+		}
+	}
+
+	return image
+}
