+	windowBox, _ := gtk.EventBoxNew()
+	windowBox.SetName(strconv.FormatUint(window.Id, 10))
+	windowBox.SetSizeRequest(width, height)
+
+	style, _ := windowBox.GetStyleContext()
+	style.AddClass("tile")
+	if window.IsUrgent {
