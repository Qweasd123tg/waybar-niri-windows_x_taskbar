new file mode 100644
index 0000000..ac6c79e
--- /dev/null
+++ b/module/icon_lookup.go
@@ -0,0 +1,181 @@
+package module
+
+/*
+#cgo pkg-config: gio-unix-2.0 gtk+-3.0
+
+#include <stdlib.h>
+
+#include <gio/gdesktopappinfo.h>
+#include <gio/gfileicon.h>
+#include <gio/gthemedicon.h>
+#include <gtk/gtk.h>
+
+static char *icon_name_from_icon(GIcon *icon) {
+	if (icon == NULL) {
+		return NULL;
+	}
+
+	if (G_IS_FILE_ICON(icon)) {
+		GFile *file = g_file_icon_get_file(G_FILE_ICON(icon));
+		if (file == NULL) {
+			return NULL;
+		}
+
+		return g_file_get_path(file);
+	}
+
+	if (G_IS_THEMED_ICON(icon)) {
+		const gchar * const *names = g_themed_icon_get_names(G_THEMED_ICON(icon));
+		GtkIconTheme *theme = gtk_icon_theme_get_default();
+
+		if (names != NULL) {
+			for (int idx = 0; names[idx] != NULL; idx++) {
+				if (theme != NULL && gtk_icon_theme_has_icon(theme, names[idx])) {
+					return g_strdup(names[idx]);
+				}
+			}
+
+			if (names[0] != NULL) {
+				return g_strdup(names[0]);
+			}
+		}
+	}
+
+	return g_icon_to_string(icon);
+}
+
+static char *icon_name_from_app_info(GDesktopAppInfo *info) {
+	if (info == NULL) {
+		return NULL;
+	}
+
+	return icon_name_from_icon(g_app_info_get_icon(G_APP_INFO(info)));
+}
+
+static char *icon_name_from_filename(const char *path) {
+	GDesktopAppInfo *info = g_desktop_app_info_new_from_filename(path);
+	if (info == NULL) {
+		return NULL;
+	}
+
+	char *result = icon_name_from_app_info(info);
+	g_object_unref(info);
+	return result;
+}
+
+static void free_desktop_app_info_search(gchar ***results) {
+	if (results == NULL) {
+		return;
+	}
+
+	for (gchar ***group = results; *group != NULL; group++) {
+		g_strfreev(*group);
+	}
+
+	g_free(results);
+}
+
+static char *lookup_desktop_app_icon(const char *app_id) {
+	if (app_id == NULL || *app_id == '\0') {
+		return NULL;
+	}
+
+	const gchar *prefixes[] = {
+		"applications/",
+		"applications/kde/",
+		"applications/org.kde.",
+	};
+	const gchar *suffixes[] = {
+		"",
+		".desktop",
+	};
+
+	const gchar *dirs[64];
+	int dir_count = 0;
+
+	const gchar *user_dir = g_get_user_data_dir();
+	if (user_dir != NULL && *user_dir != '\0') {
+		dirs[dir_count++] = user_dir;
+	}
+
+	const gchar * const *system_dirs = g_get_system_data_dirs();
+	for (const gchar * const *dir = system_dirs; dir != NULL && *dir != NULL && dir_count < 64; dir++) {
+		dirs[dir_count++] = *dir;
+	}
+
+	for (int dir_idx = 0; dir_idx < dir_count; dir_idx++) {
+		for (int prefix_idx = 0; prefix_idx < 3; prefix_idx++) {
+			for (int suffix_idx = 0; suffix_idx < 2; suffix_idx++) {
+				gchar *relative = g_strdup_printf("%s%s%s", prefixes[prefix_idx], app_id, suffixes[suffix_idx]);
+				gchar *path = g_build_filename(dirs[dir_idx], relative, NULL);
+				g_free(relative);
+
+				char *result = icon_name_from_filename(path);
+				g_free(path);
+
+				if (result != NULL) {
+					return result;
+				}
+			}
+		}
+	}
+
+	for (int suffix_idx = 0; suffix_idx < 2; suffix_idx++) {
+		gchar *desktop_id = g_strdup_printf("%s%s", app_id, suffixes[suffix_idx]);
+		GDesktopAppInfo *info = g_desktop_app_info_new(desktop_id);
+		g_free(desktop_id);
+
+		if (info != NULL) {
+			char *result = icon_name_from_app_info(info);
+			g_object_unref(info);
+
+			if (result != NULL) {
+				return result;
+			}
+		}
+	}
+
+	gchar ***results = g_desktop_app_info_search(app_id);
+	for (gchar ***group = results; group != NULL && *group != NULL; group++) {
+		for (gchar **desktop_id = *group; *desktop_id != NULL; desktop_id++) {
+			GDesktopAppInfo *info = g_desktop_app_info_new(*desktop_id);
+			if (info == NULL) {
+				continue;
+			}
+
+			char *result = icon_name_from_app_info(info);
+			g_object_unref(info);
+
+			if (result != NULL) {
+				free_desktop_app_info_search(results);
+				return result;
+			}
+		}
+	}
+
+	free_desktop_app_info_search(results);
+	return NULL;
+}
+*/
+import "C"
+
+import (
+	"unsafe"
+)
+
+func lookupDesktopAppIcon(appID string) (string, bool) {
+	if appID == "" {
+		return "", false
+	}
+
+	cAppID := C.CString(appID)
+	defer C.free(unsafe.Pointer(cAppID))
+
+	resolved := C.lookup_desktop_app_icon(cAppID)
+	if resolved == nil {
+		return "", false
+	}
+	defer C.g_free(C.gpointer(unsafe.Pointer(resolved)))
+
+	return C.GoString(resolved), true
+}
